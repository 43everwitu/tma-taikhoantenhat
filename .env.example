# ================================================
# Taikhoantenhat — cấu hình môi trường
# ================================================
# Copy: cp .env.example .env
# Quote values containing '#' to avoid dotenv truncation:
#   ADMIN_INITIAL_PASSWORD='abc#def'
# ================================================


# ---------- Telegram bot ----------

# Bot token từ @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram ID của admin chính (chat trực tiếp với @userinfobot hoặc log từ bot)
ADMIN_ID=your_telegram_id_here

# Username bot (không bắt buộc, dùng cho deep link /start?startapp=order_<id>)
# BOT_USERNAME=taikhoantenhat_bot

# Channel/group nhận tin nhắn admin-notify khi bị tắt cho event đó
# (bị tắt theo settings → vẫn chuyển vào đây để audit)
# BOT_NOISE_CHAT_ID=-1001234567890

# Channel/group đăng feed đơn hàng (group.order_card template).
# Bỏ trống = không đăng feed.
# ORDER_CHANNEL_CHAT_ID=-1001234567890
# ORDER_CHANNEL_THREAD_ID=2          # tùy chọn — message_thread_id cho forum topic


# ---------- Telegram Mini App ----------

# URL Mini App (đăng ký với @BotFather /newapp). Production HTTPS.
MINIAPP_URL=https://taikhoantenhat.example.com/


# ---------- Ngân hàng (bắt buộc — VietQR) ----------

BANK_BIN=970422
BANK_ACCOUNT=your_bank_account_number
BANK_ACCOUNT_NAME=YOUR_FULL_NAME
BANK_NAME=MB

# Bỏ comment để bật ngân hàng thứ 2 (admin sẽ chọn 1 trong 2 khi tạo QR)
# BANK2_BIN=970436
# BANK2_ACCOUNT=your_second_bank_account
# BANK2_ACCOUNT_NAME=YOUR_FULL_NAME
# BANK2_NAME=VCB


# ---------- API server & Web ----------

NODE_ENV=development
# Runtime timezone for logs, local Date behavior, and SQLite localtime modifiers.
# SQLite datetime('now')/CURRENT_TIMESTAMP remain UTC.
TZ=Asia/Ho_Chi_Minh
API_PORT=3000
WEB_PORT=3001
WEB_URL=http://localhost:3001

# Next.js rewrite target (production: trỏ localhost API, không expose ra internet)
# API_BACKEND_URL=http://127.0.0.1:3000

# Frontend → backend base URL (mặc định same-origin với rewrite /api/*).
# Set khi web chạy domain khác hoặc qua tunnel.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1


# ---------- MBBank sidecar ----------
# Trên VPS: trỏ tới process MBBank đang chạy sẵn (PM2/systemd khác).
# Dev local: uvicorn trên :8000 (npm run dev:mbbank hoặc dev:all).
# Sidecar load .env này (repo-root). MBBANK_API_TOKEN cũng được sidecar đọc
# với tên API_ACCESS_TOKEN — chỉ cần khai báo 1 chỗ ở đây.

MBBANK_API_URL=http://127.0.0.1:8000
MBBANK_API_TOKEN=your_mbbank_api_bearer_token

# MBBank login (sidecar dùng để gọi /transactions/credit poll).
MB_USERNAME=your_mb_login_phone
MB_PASSWORD=your_mb_password
MB_CAPTCHA=

# Poller tick interval (ms) khi có đơn pending. 30s là default thực tế.
PAYMENT_POLL_INTERVAL=30000
PAYMENT_POLL_ENABLED=true


# ---------- Authentication & encryption ----------

# 64 hex chars — sinh: openssl rand -hex 32
JWT_SECRET=your_random_64_char_secret_here

# Mật khẩu admin đầu tiên — đổi sau khi đăng nhập (npm run admin:reset-password)
ADMIN_INITIAL_PASSWORD=change_me_on_first_login

# AES-256-GCM key mã hoá orders.input_value — sinh: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars


# ---------- Shop branding ----------

SHOP_NAME=Taikhoantenhat
SUPPORT_CONTACT=@taikhoantenhat_support


# ---------- Feature flags ----------
# Bật/tắt module trong sidebar admin + bot. GET /admin/features expose cho frontend.

FEATURE_TOPUPS=false       # /nap, /admin/topups
FEATURE_BROADCAST=false    # /admin/announcements (web popup + bot broadcast)
FEATURE_TELEGRAM_NOTIFY=order_only   # order_only | full


# ---------- Migrations (optional) ----------

# Đường dẫn tarball/dir backup WordPress để import. Mặc định auto-detect ở
# repo root hoặc thư mục cha telegram-shop-bot/.
# WP_BACKUP_ROOT=/path/to/wp-backup


